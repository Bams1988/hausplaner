rules_version = '2';
// Sicherheitsregeln für MindSpace.
// Mitglieder sehen die Daten ihres gemeinsamen Bereichs. Mitglieder mit eingeschränktem Zugriff
// (project.access[uid] = Liste von Bereichs-IDs) sehen nur Aufgaben, Kosten, Dateien und Kommentare
// dieser Bereiche – E-Mail-Ablage, KI-Schlüssel und Einstellungen bleiben für sie unsichtbar.
// Abo-Felder (plan, Limits, Verbrauch, E-Mail-Adresse) schreibt nur der Server.
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function proj(pid) { return get(/databases/$(db)/documents/projects/$(pid)).data; }
    function isMember(pid) { return signedIn() && request.auth.uid in proj(pid).members; }
    function scopeOf(pid) { return proj(pid).get('access', {}).get(request.auth.uid, 'all'); }
    function isFull(pid) { return isMember(pid) && scopeOf(pid) == 'all'; }
    function canArea(pid, areaId) { return isMember(pid) && (scopeOf(pid) == 'all' || areaId in scopeOf(pid)); }
    function serverUserKeys() { return ['plan', 'planUntil', 'planSource', 'planSyncedAt', 'grant', 'grantUntil', 'grantSource']; }
    function serverProjectKeys() { return ['plan', 'planBy', 'planAt', 'planDay', 'storageLimit', 'memberLimit', 'storageBytes', 'inboxAlias', 'backend']; }

    // Eigenes Profil (Name, Projekt, Sprache, Push-Geräte, Kalender) – Abo-Felder nur vom Server
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid && !request.resource.data.keys().hasAny(serverUserKeys());
      allow update: if signedIn() && request.auth.uid == uid && !request.resource.data.diff(resource.data).affectedKeys().hasAny(serverUserKeys());
    }

    // Kalender-Abo: je Mitglied ein geheimer Schlüssel; nur der Besitzer darf ihn anlegen, ändern oder löschen
    match /calFeeds/{token} {
      allow get, delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && isMember(request.resource.data.pid);
      allow update: if signedIn() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid && isMember(request.resource.data.pid);
    }

    // Feedback aus der Testphase: nur anlegen, lesen nur in der Firebase-Konsole
    match /feedback/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string && request.resource.data.text.size() <= 4000
        && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'text', 'kind', 'view', 'version', 'device', 'plan', 'at']);
    }

    // Einladungscodes: nur einzeln abrufbar (kein Auflisten), 7 Tage gültig
    match /invites/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && isFull(request.resource.data.projectId);
      allow delete: if signedIn() && isFull(resource.data.projectId);
    }

    match /projects/{pid} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && request.resource.data.members == [request.auth.uid] && !request.resource.data.keys().hasAny(serverProjectKeys());
      allow update: if signedIn() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(serverProjectKeys()) && (
        (request.auth.uid in resource.data.members && resource.data.get('access', {}).get(request.auth.uid, 'all') == 'all')
        || (
          // Beitreten mit gültigem Code: nur sich selbst hinzufügen, mit dem Zugriff aus der Einladung –
          // und nur, solange das Personenlimit des Abos nicht erreicht ist
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberNames', 'joinCode', 'access'])
          && request.resource.data.members == resource.data.members.concat([request.auth.uid])
          && resource.data.members.size() < resource.data.get('memberLimit', 100)
          && request.resource.data.get('access', {}).diff(resource.data.get('access', {})).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.get('access', {}).get(request.auth.uid, 'all') == get(/databases/$(db)/documents/invites/$(request.resource.data.joinCode)).data.get('scope', 'all')
          && get(/databases/$(db)/documents/invites/$(request.resource.data.joinCode)).data.projectId == pid
          && get(/databases/$(db)/documents/invites/$(request.resource.data.joinCode)).data.expiresAt > request.time
        )
      );
      allow delete: if false;

      // Daten je Bereich
      match /tasks/{id} {
        allow read, delete: if canArea(pid, resource.data.areaId);
        allow create: if canArea(pid, request.resource.data.areaId);
        allow update: if canArea(pid, resource.data.areaId) && canArea(pid, request.resource.data.areaId);
      }
      match /costs/{id} {
        allow read, delete: if canArea(pid, resource.data.areaId);
        allow create: if canArea(pid, request.resource.data.areaId);
        allow update: if canArea(pid, resource.data.areaId) && canArea(pid, request.resource.data.areaId);
      }
      match /files/{id} {
        allow read, delete: if canArea(pid, resource.data.areaId);
        allow create: if canArea(pid, request.resource.data.areaId);
        allow update: if canArea(pid, resource.data.areaId) && canArea(pid, request.resource.data.areaId);
      }
      // Dateiinhalte in Teilen (bisheriger Betrieb). Mit Server-Diensten liegen Dateien in Cloud Storage.
      match /fileParts/{id} {
        allow read, delete: if canArea(pid, resource.data.areaId);
        allow create, update: if canArea(pid, request.resource.data.areaId) && !proj(pid).get('backend', false);
      }
      match /comments/{id} {
        allow read: if canArea(pid, resource.data.areaId);
        allow create: if canArea(pid, request.resource.data.areaId) && request.resource.data.by == request.auth.uid;
        allow delete: if isFull(pid) || (canArea(pid, resource.data.areaId) && resource.data.by == request.auth.uid);
        allow update: if isFull(pid);
      }
      match /areas/{areaId} {
        allow read: if canArea(pid, areaId);
        allow write: if isFull(pid);
      }
      match /contacts/{id} {
        allow read, write: if isMember(pid);
      }
      // Verbrauch (KI-Aktionen, E-Mails) – lesen ja, schreiben nur der Server
      match /usage/{month} {
        allow read: if isMember(pid);
      }
      match /mailLog/{id} {
        allow read: if isFull(pid);
      }
      // Alles andere (E-Mail-Ablage, KI-Schlüssel, Protokolle) nur mit vollem Zugriff
      match /{coll}/{rest=**} {
        allow read, write: if isFull(pid) && !(coll in ['usage', 'mailLog']);
      }
    }
  }
}
