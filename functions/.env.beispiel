# Kopieren nach functions/.env und ausfüllen (keine Geheimnisse – die kommen per „firebase functions:secrets:set“)
# Adresse der Web-Version (für Links in Kalender und Push-Nachrichten)
APP_URL=https://bams1988.github.io/hausplaner/
# Domain für den E-Mail-Eingang (Schritt 6), z. B. in.mindspace-app.de – leer lassen, solange nicht eingerichtet
MAIL_DOMAIN=
# Testphase: Code, den du deinen Testern gibst (leer lassen = keine Testphase). Damit wählen Tester ihre Abo-Stufe kostenlos.
BETA_CODE=
# Deine E-Mail-Adresse (wie in MindSpace angemeldet) – du bekommst Feedback der Tester als Push
ADMIN_EMAIL=
